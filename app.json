{
  "expo": {
    "name": "Legathon Walk",
    "slug": "legathonwalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "legathonwalk",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.legathonwalk.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Legathon Walk uses location to track walking journeys and route progress.",
        "NSMotionUsageDescription": "Legathon Walk uses motion activity to count steps and track wellness progress.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.legathonwalk.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "90ab6971-beb3-493e-90fc-b4fa5d093077"
      }
    }
  }
}
